# HTTPS-сертификат Caddy выпускает и продлевает сам (Let's Encrypt) для домена из .env.
# Директивы log нет намеренно: журнал запросов с IP-адресами не ведётся.
{$DOMAIN} {
	request_body {
		max_size 32KB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy api:8080
}
