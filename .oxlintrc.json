{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "android/**"
  ],
  "overrides": [
    {
      "files": [
        "server/**/*.js"
      ],
      "env": {
        "node": true,
        "browser": false
      }
    }
  ]
}
